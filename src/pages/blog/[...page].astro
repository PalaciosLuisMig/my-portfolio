---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import PostCard from "@components/PostCard.astro";
import { getCollection } from "astro:content";
import createSlug from "@lib/create_slug";
import type { Page } from "astro";
import dayjs from "dayjs";
import "dayjs/locale/es";
import localizedFormat from "dayjs/plugin/localizedFormat";

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  // Tiempo de lectura estimado a partir del contenido del post (~200 palabras/min).
  // Debe vivir dentro de getStaticPaths: Astro la ejecuta en un scope aislado.
  const readingTime = (body: string) => {
    const words = (body ?? "").trim().split(/\s+/).filter(Boolean).length;
    return Math.max(1, Math.round(words / 200));
  };

  const posts = await getCollection("blog");
  if (!posts) return paginate([], { pageSize: 6 });

  const ordered = posts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((p) => ({ ...p, readingMinutes: readingTime(p.body) }));

  return paginate(ordered, { pageSize: 6, props: { total: ordered.length } });
}

interface Props {
  page: Page;
  total: number;
}

const { page, total } = Astro.props;
const totalPages = Math.max(1, page.lastPage);

dayjs.extend(localizedFormat);
dayjs.locale("es");
const formatDate = (d: Date) => dayjs(d).format("LL");
---

<Layout title="Blog" urlMenuItem="/blog">
  <div id="blog" class="max-w-screen-lg mx-auto px-5">

    <!-- ============ HERO BLOG ============ -->
    <section class="pt-12 pb-8 md:pt-16">
      <p class="font-mono text-xs uppercase tracking-widest text-primary mb-2 animate-fade-down">Escribo sobre lo que aprendo</p>
      <h1 class="text-2xl md:text-3xl font-bold text-base-content mb-3 flex items-center gap-2 animate-fade-right">
        <Icon name="lucide:newspaper" size={28} class="text-primary" />Blog
      </h1>
      <p class="text-base-content/70 max-w-2xl animate-fade-right animate-delay-100">
        Artículos sobre desarrollo, herramientas y buenas prácticas que voy aprendiendo
        en el camino.
        {total > 0 && (
          <span class="font-medium text-base-content"> {total} publicaciones.</span>
        )}
      </p>
    </section>

    <!-- ============ GRID DE POSTS ============ -->
    <section class="mb-12">
      {page.data.length === 0 ? (
        <div role="alert" class="alert alert-warning">
          <Icon name="lucide:info" size={20} />
          <div>
            <h3 class="font-bold">No hay publicaciones por ahora</h3>
            <p class="text-sm">Vuelve más tarde para leer nuevos artículos.</p>
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-10 items-stretch">
          {page.data.map((post, i) => (
            <div class="h-full animate-fade-up" style={`animation-delay: ${(i % 6) * 80}ms`}>
              <PostCard
                href={"/blog/" + createSlug(post.data.title, post.slug)}
                title={post.data.title}
                description={post.data.description}
                heroImage={post.data.heroImage}
                badge={post.data.badge}
                date={formatDate(post.data.pubDate)}
                readingMinutes={post.readingMinutes}
              />
            </div>
          ))}
        </div>
      )}

      <!-- Paginacion -->
      {totalPages > 1 && (
        <div class="flex items-center justify-between gap-4">
          {page.url.prev ? (
            <a href={page.url.prev} class="btn btn-outline btn-sm md:btn-md gap-1">
              <Icon name="lucide:arrow-left" size={18} />
              <span class="hidden sm:inline">Recientes</span>
            </a>
          ) : (
            <span />
          )}

          <span class="font-mono text-sm text-base-content/60">
            Página {page.currentPage} de {totalPages}
          </span>

          {page.url.next ? (
            <a href={page.url.next} class="btn btn-outline btn-sm md:btn-md gap-1">
              <span class="hidden sm:inline">Anteriores</span>
              <Icon name="lucide:arrow-right" size={18} />
            </a>
          ) : (
            <span />
          )}
        </div>
      )}
    </section>

    <!-- Boton flotante: volver arriba -->
    <button
      id="back-to-top"
      class="btn btn-primary btn-circle fixed bottom-6 right-6 z-30 shadow-lg opacity-0 pointer-events-none transition-opacity"
      aria-label="Volver arriba"
    >
      <Icon name="lucide:arrow-up" size={20} />
    </button>
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const backToTop = document.getElementById("back-to-top");
    if (backToTop) {
      const toggleBtn = () => {
        const show = window.scrollY > 500;
        backToTop.classList.toggle("opacity-0", !show);
        backToTop.classList.toggle("pointer-events-none", !show);
      };
      toggleBtn();
      window.addEventListener("scroll", toggleBtn, { passive: true });
      backToTop.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
  });
</script>
