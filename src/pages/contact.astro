---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { MYEMAIL, CV_DOWNLOAD, CV_FILENAME } from "../config";

const SOCIALS = [
  { name: "LinkedIn", handle: "in/palaciosluismig", icon: "simple-icons:linkedin", url: "https://www.linkedin.com/in/palaciosluismig/" },
  { name: "GitHub", handle: "palaciosluismig", icon: "simple-icons:github", url: "https://github.com/palaciosluismig" },
  { name: "Instagram", handle: "@palaciosluismig", icon: "simple-icons:instagram", url: "https://www.instagram.com/palaciosluismig/" },
];
---

<Layout title="Contacto" urlMenuItem="/contact">
  <div class="max-w-screen-lg mx-auto px-5">

    <!-- ============ HERO ============ -->
    <section class="pt-12 pb-8 md:pt-16">
      <p class="font-mono text-xs uppercase tracking-widest text-primary mb-2 animate-fade-down">Hablemos</p>
      <h1 class="text-2xl md:text-3xl font-bold text-base-content mb-3 flex items-center gap-2 animate-fade-right">
        <Icon name="lucide:mail" size={28} class="text-primary" />Contáctame
      </h1>
      <p class="text-base-content/70 max-w-2xl animate-fade-right animate-delay-100">
        ¿Tienes un proyecto en mente o quieres conversar sobre software, arquitectura o
        medios de pago? Escríbeme y te respondo pronto.
      </p>
    </section>

    <div class="grid gap-6 lg:grid-cols-2 mb-16 items-start">

      <!-- ============ FORMULARIO (Netlify Forms) ============ -->
      <div class="card bg-base-100 border border-base-300 shadow-md animate-fade-up">
        <div class="card-body">
          <h2 class="card-title text-lg">
            <Icon name="lucide:send" size={20} class="text-primary" />Envíame un mensaje
          </h2>

          <div id="form-success" role="alert" class="alert alert-success hidden mt-2">
            <Icon name="lucide:circle-check" size={18} />
            <span>¡Gracias! Tu mensaje fue enviado. Te responderé pronto.</span>
          </div>

          <form
            id="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/__forms.html"
            class="mt-2 flex flex-col gap-4"
          >
            <!-- Requeridos por Netlify Forms -->
            <input type="hidden" name="form-name" value="contact" />
            <!-- Asunto del correo de notificacion (sin prefijo [Netlify]) -->
            <input
              type="hidden"
              name="subject"
              data-remove-prefix
              value="Nuevo mensaje de contacto desde tu portafolio"
            />
            <p class="hidden">
              <label>No llenar si eres humano: <input name="bot-field" /></label>
            </p>

            <label class="form-control w-full">
              <span class="label-text mb-1 text-sm font-medium">Nombre</span>
              <input
                type="text"
                name="name"
                required
                placeholder="Tu nombre"
                class="input input-bordered w-full"
              />
            </label>

            <label class="form-control w-full">
              <span class="label-text mb-1 text-sm font-medium">Correo electrónico</span>
              <input
                type="email"
                name="email"
                required
                placeholder="tucorreo@ejemplo.com"
                class="input input-bordered w-full"
              />
            </label>

            <label class="form-control w-full">
              <span class="label-text mb-1 text-sm font-medium">Mensaje</span>
              <textarea
                name="message"
                required
                rows="5"
                placeholder="Cuéntame en qué puedo ayudarte…"
                class="textarea textarea-bordered w-full"
              ></textarea>
            </label>

            <button type="submit" class="btn btn-primary gap-2">
              <Icon name="lucide:send" size={18} />Enviar mensaje
            </button>
          </form>
        </div>
      </div>

      <!-- ============ DATOS DE CONTACTO ============ -->
      <div class="flex flex-col gap-6">

        <!-- Email -->
        <div class="card bg-base-100 border border-base-300 shadow-md animate-fade-up animate-delay-100">
          <div class="card-body">
            <h2 class="card-title text-lg">
              <Icon name="lucide:at-sign" size={20} class="text-primary" />Correo electrónico
            </h2>
            <p id="lblEmail" class="font-mono text-sm md:text-base text-base-content/80 break-all">{MYEMAIL}</p>
            <div class="card-actions mt-2">
              <a href={`mailto:${MYEMAIL}`} class="btn btn-primary btn-sm gap-2">
                <Icon name="lucide:send" size={16} />Enviar
              </a>
              <button id="btnEmailCopy" class="btn btn-outline btn-sm gap-2">
                <Icon name="lucide:copy" size={16} />Copiar
              </button>
            </div>
          </div>
        </div>

        <!-- Redes sociales -->
        <div class="card bg-base-100 border border-base-300 shadow-md animate-fade-up animate-delay-200">
          <div class="card-body">
            <h2 class="card-title text-lg">
              <Icon name="lucide:share-2" size={20} class="text-primary" />Redes sociales
            </h2>
            <div class="flex flex-col gap-2 mt-1">
              {SOCIALS.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-3 rounded-box border border-base-300 bg-base-200 px-4 py-3 transition-colors hover:border-primary"
                >
                  <Icon name={s.icon} size={22} class="text-base-content/70 group-hover:text-primary transition-colors" />
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-base-content">{s.name}</div>
                    <div class="text-xs text-base-content/50 truncate">{s.handle}</div>
                  </div>
                  <Icon name="lucide:external-link" size={16} class="text-base-content/30 group-hover:text-primary transition-colors" />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Descargar CV -->
        <button
          id="btn-download-contact"
          class="btn btn-accent gap-2 hover:scale-[1.02] animate-fade-up animate-delay-300"
          data-cv-url={CV_DOWNLOAD}
          data-cv-name={CV_FILENAME}
        >
          <Icon name="lucide:download" size={20} />Descargar CV
        </button>
      </div>
    </div>

    <!-- Toast de "copiado" -->
    <div id="altEmailCopy" class="toast toast-center hidden">
      <div class="alert alert-success">
        <Icon name="lucide:check" size={18} />
        <span>Correo copiado</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    // Copiar correo al portapapeles con feedback (toast).
    const toast = document.getElementById("altEmailCopy");
    const btnCopy = document.getElementById("btnEmailCopy");
    btnCopy?.addEventListener("click", () => {
      const email = document.getElementById("lblEmail")?.textContent?.trim() || "";
      navigator.clipboard.writeText(email);
      toast?.classList.remove("hidden");
      setTimeout(() => toast?.classList.add("hidden"), 2000);
    });

    // Descargar CV.
    const btnDownload = document.getElementById("btn-download-contact");
    btnDownload?.addEventListener("click", () => {
      const url = (btnDownload as HTMLElement).dataset.cvUrl || "";
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", (btnDownload as HTMLElement).dataset.cvName || "");
      link.click();
    });

    // Envio del formulario a Netlify Forms.
    // En sitios SSR el POST se hace a /__forms.html (form estatico que Netlify
    // detecta) via fetch, mostrando el exito sin recargar la pagina.
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const ok = document.getElementById("form-success");
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      try {
        // Netlify Forms en SSR: el POST debe ir al asset estatico /__forms.html,
        // que Netlify sirve directamente y cuyo POST captura el handler de Forms.
        // Un POST a "/" seria interceptado por la funcion SSR y NO se registraria.
        const data = new FormData(form);
        const res = await fetch("/__forms.html", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(data as any).toString(),
        });
        if (!res.ok) throw new Error(`Netlify Forms respondio ${res.status}`);
        form.reset();
        ok?.classList.remove("hidden");
        ok?.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (err) {
        console.error("Error al enviar el formulario:", err);
        alert("No se pudo enviar el mensaje. Intenta de nuevo o escríbeme por correo.");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>
