---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import Error404Image from "@components/Error404Image.astro";
---

<Layout title="404 - Página no encontrada" urlMenuItem="/">
  <div class="max-w-screen-lg mx-auto px-5">
    <section class="min-h-[70vh] flex flex-col items-center justify-center text-center py-16">

      <!-- Ilustracion (se tine con el tema activo) -->
      <div class="mb-8 animate-fade-up">
        <Error404Image />
      </div>

      <!-- 404 -->
      <p class="font-mono text-xs uppercase tracking-widest text-primary mb-2 animate-fade-down">Error 404</p>
      <h1 class="text-4xl md:text-6xl font-extrabold text-base-content mb-3 animate-fade-up">
        Página no encontrada
      </h1>
      <p class="text-base-content/70 max-w-lg mb-8 animate-fade-up animate-delay-100">
        La página que buscas no existe o fue movida. Puedes volver atrás o explorar
        alguna de estas secciones.
      </p>

      <!-- Acciones -->
      <div class="flex flex-wrap justify-center gap-3 animate-fade-up animate-delay-200">
        <a href="/" class="btn btn-primary gap-2">
          <Icon name="lucide:house" size={18} />Ir al inicio
        </a>
        <button id="btnReturnPage" type="button" class="btn btn-outline gap-2">
          <Icon name="lucide:arrow-left" size={18} />Regresar
        </button>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.querySelector("#btnReturnPage");
    btn?.addEventListener("click", () => {
      // Si hay historial previo en el sitio, vuelve; si no, va al inicio.
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "/";
      }
    });
  });
</script>
