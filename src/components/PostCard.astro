---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// Tarjeta vertical de post (imagen arriba, contenido abajo).
interface Props {
  href: string;
  title: string;
  description: string;
  heroImage?: string;
  badge?: string;
  date: string;
  readingMinutes: number;
  featured?: boolean;
}

const { href, title, description, heroImage, badge, date, readingMinutes, featured } = Astro.props;

// URLs externas (http/https) usan <img> nativo; las locales, <Image> optimizado.
const isRemote = typeof heroImage === "string" && /^https?:\/\//.test(heroImage);
---

<a
  href={href}
  class="group card h-full flex flex-col bg-base-100 shadow-md overflow-hidden transition-all hover:-translate-y-1 hover:shadow-xl"
>
  <!-- Imagen: siempre presente y con proporcion fija para altura uniforme -->
  <figure class="relative aspect-video shrink-0 overflow-hidden bg-base-200">
    {heroImage ? (
      isRemote ? (
        <img
          src={heroImage}
          width={750}
          height={422}
          loading="lazy"
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <Image
          src={heroImage}
          width={750}
          height={422}
          format="webp"
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      )
    ) : (
      <div class="flex h-full w-full items-center justify-center text-base-content/20">
        <Icon name="lucide:image" size={48} />
      </div>
    )}
    {featured && (
      <span class="badge badge-primary badge-sm gap-1 absolute top-3 left-3">
        <Icon name="lucide:star" size={12} />Destacado
      </span>
    )}
  </figure>

  <div class="card-body flex flex-1 flex-col gap-2">
    {badge && <span class="badge badge-soft badge-sm w-fit">{badge}</span>}
    <h3 class="card-title text-lg md:text-xl text-base-content line-clamp-2 min-h-[3.5rem] group-hover:text-primary transition-colors">
      {title}
    </h3>
    <p class="text-sm text-base-content/70 line-clamp-2 min-h-[2.5rem]">{description}</p>
    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-1 text-xs text-base-content/60">
      <span class="flex items-center gap-1">
        <Icon name="lucide:calendar" size={13} />{date}
      </span>
      <span class="flex items-center gap-1">
        <Icon name="lucide:clock" size={13} />{readingMinutes} min de lectura
      </span>
    </div>
  </div>
</a>
