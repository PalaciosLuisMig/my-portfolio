---
import { MYEMAIL } from "../config";
import { Icon } from "astro-icon/components";

const currentYear = new Date().getFullYear();

const NAV_LINKS = [
  { label: "Perfil", href: "/profile" },
  { label: "Experiencia", href: "/experience" },
  { label: "Proyectos", href: "/projects" },
  { label: "Blog", href: "/blog" },
  { label: "Contacto", href: "/contact" },
];

const SOCIALS = [
  { icon: "simple-icons:linkedin", url: "https://www.linkedin.com/in/palaciosluismig/", label: "LinkedIn" },
  { icon: "simple-icons:github", url: "https://github.com/palaciosluismig", label: "GitHub" },
  { icon: "simple-icons:instagram", url: "https://www.instagram.com/palaciosluismig/", label: "Instagram" },
];
---

<footer class="bg-base-200 border-t border-base-300 text-base-content">
  <div class="max-w-screen-lg mx-auto px-5 py-12">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">

      <!-- Marca -->
      <div class="md:col-span-2">
        <a href="/" class="inline-flex items-center gap-2 mb-3">
          <Icon name="favicon" size={36} class="text-base-content" />
          <span class="text-lg font-bold">Luis Palacios</span>
        </a>
        <p class="text-sm text-base-content/70 max-w-sm">
          Desarrollo de software a medida: aplicaciones web y móviles, APIs e
          integraciones, arquitectura de sistemas y soluciones de medios de pago.
          Del diseño al despliegue, con foco en calidad, seguridad y resultados.
        </p>
        <!-- Redes -->
        <div class="mt-5 flex items-center gap-3">
          {SOCIALS.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="btn btn-circle btn-sm btn-ghost text-base-content/70 hover:text-primary"
            >
              <Icon name={s.icon} size={20} />
            </a>
          ))}
        </div>
      </div>

      <!-- Navegacion -->
      <nav>
        <h4 class="font-mono text-xs uppercase tracking-widest text-base-content/50 mb-4">Navegación</h4>
        <ul class="flex flex-col gap-2">
          {NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex items-center gap-1.5 text-sm text-base-content/80 hover:text-primary transition-colors"
              >
                <Icon name="lucide:chevron-right" size={14} class="text-primary" />{link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contacto -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-widest text-base-content/50 mb-4">Contacto</h4>
        <a
          href={`mailto:${MYEMAIL}`}
          class="inline-flex items-start gap-2 text-sm text-base-content/80 hover:text-primary transition-colors break-all"
        >
          <Icon name="lucide:at-sign" size={16} class="mt-0.5 shrink-0 text-primary" />
          <span id="lblEmailFooter">{MYEMAIL}</span>
        </a>
        <div class="mt-3 flex gap-2">
          <a href={`mailto:${MYEMAIL}`} class="btn btn-primary btn-xs gap-1">
            <Icon name="lucide:send" size={14} />Enviar
          </a>
          <button id="btnEmailCopyFooter" class="btn btn-outline btn-xs gap-1">
            <Icon name="lucide:copy" size={14} />Copiar
          </button>
        </div>
        <a href="/contact" class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-primary hover:underline">
          Ir a contacto<Icon name="lucide:arrow-right" size={14} />
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-base-300 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-base-content/60">
      <p class="flex items-center gap-1.5">
        <Icon name="lucide:map-pin" size={14} />Cuenca, Ecuador
      </p>
      <p class="flex items-center gap-1.5">
        Hecho con <Icon name="lucide:heart" size={14} class="text-primary" /> · {currentYear} © Luis Palacios
      </p>
    </div>
  </div>

  <!-- Toast de "copiado" -->
  <div id="altEmailCopyFooter" class="toast toast-center hidden">
    <div class="alert alert-success">
      <Icon name="lucide:check" size={16} />
      <span>Correo copiado</span>
    </div>
  </div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    const toast = document.getElementById("altEmailCopyFooter");
    const btnCopy = document.getElementById("btnEmailCopyFooter");
    btnCopy?.addEventListener("click", () => {
      const email = document.getElementById("lblEmailFooter")?.textContent?.trim() || "";
      navigator.clipboard.writeText(email);
      toast?.classList.remove("hidden");
      setTimeout(() => toast?.classList.add("hidden"), 2000);
    });
  });
</script>
