---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const {
  company,
  job,
  tags,
  date,
  city,
  country,
  logo,
  description,
  requirements,
  href,
  id,
  first = false,
  last = false,
  side = "end", // "start" (izquierda) | "end" (derecha) — solo aplica en desktop
} = Astro.props;

// En desktop se alterna izquierda/derecha. En movil todo va a la derecha (ver <style>).
const contentClass =
  side === "start" ? "timeline-start md:text-end me-4" : "timeline-end ms-4";
---

<li id={id} class="tl-item tl-reveal">
  <!-- Conector superior (omitido en el primer item para que la linea no sobresalga) -->
  {!first && <hr class="bg-base-300" />}

  <!-- Nodo: logo de la empresa -->
  <div class="timeline-middle">
    <span
      class="flex h-11 w-11 md:h-12 md:w-12 items-center justify-center overflow-hidden rounded-full bg-base-100 ring-2 ring-primary shadow-sm"
    >
      <Image
        src={logo}
        height={48}
        width={48}
        alt={`Logo ${company}`}
        class="h-7 w-7 md:h-8 md:w-8 object-contain"
      />
    </span>
  </div>

  <!-- Contenido (alterna izquierda/derecha en desktop; ancho completo en movil) -->
  <div class={`${contentClass} mb-10`}>
    <div class={`flex flex-wrap items-baseline gap-x-2 ${side === "start" ? "md:justify-end" : ""}`}>
      <h3 class="text-lg md:text-xl font-bold text-base-content">{job}</h3>
      <span class="text-lg md:text-xl font-semibold text-accent">· {company}</span>
    </div>

    <p class="font-mono text-xs md:text-sm text-base-content/50 mt-1">
      {date} · {city}, {country}
    </p>

    {
      tags && tags.length > 0 && (
        <div class={`mt-2 flex flex-wrap gap-2 ${side === "start" ? "md:justify-end" : ""}`}>
          {tags.map((tag: string) => (
            <span class="badge badge-primary badge-outline text-xs h-auto whitespace-normal py-1 text-left">{tag}</span>
          ))}
        </div>
      )
    }

    <p class="mt-3 text-sm md:text-base text-base-content/80 leading-relaxed">
      {description}
    </p>

    {
      requirements && requirements.length > 0 && (
        <details class="tl-details group/details mt-4 text-start">
          <summary class="mx-auto flex w-fit cursor-pointer list-none items-center gap-1.5 rounded-full border border-base-300 px-4 py-1.5 text-sm font-medium text-primary transition-colors hover:border-primary hover:bg-base-200">
            <Icon name="lucide:list-checks" size={15} />
            <span>Ver logros ({requirements.length})</span>
            <Icon
              name="lucide:chevron-down"
              size={15}
              class="transition-transform group-open/details:rotate-180"
            />
          </summary>
          <ul class="mt-4 space-y-1.5">
            {requirements.map((requirement: string) => (
              <li class="flex gap-2 text-sm text-base-content/70">
                <Icon name="lucide:check" size={16} class="mt-1 shrink-0 text-primary" />
                <span>{requirement}</span>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {
      href && (
        <a href={href} class={`btn btn-link btn-sm px-0 mt-2 no-underline hover:underline ${side === "start" ? "md:float-right" : ""}`}>
          Ver más detalle
          <Icon name="lucide:arrow-right" size={16} />
        </a>
      )
    }
  </div>

  {!last && <hr class="bg-base-300" />}
</li>

<style is:global>
  /* Animacion de entrada al hacer scroll (revela cada item del timeline). */
  .tl-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .tl-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  /* Respeta la preferencia de reducir movimiento. */
  @media (prefers-reduced-motion: reduce) {
    .tl-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* MOVIL: reconstruimos el item del timeline como flex (logo a la izquierda,
     contenido a la derecha), evitando el grid alternado de DaisyUI que en
     pantallas pequenas deja el contenido angosto y desalineado. */
  @media (max-width: 767px) {
    ul.timeline .tl-item {
      display: grid;
      grid-template-columns: 2.75rem 1fr;
      grid-template-rows: auto auto auto;
      column-gap: 0.75rem;
      align-items: start;
    }
    ul.timeline .tl-item > .timeline-middle {
      grid-column: 1;
      grid-row: 1 / span 3;
      align-self: start;
      margin-top: 0.125rem;
    }
    /* Cualquiera de los dos lados ocupa la columna de contenido. */
    ul.timeline .tl-item > .timeline-start,
    ul.timeline .tl-item > .timeline-end {
      grid-column: 2;
      grid-row: 2;
      text-align: left !important;
      margin: 0 0 2.5rem 0;
    }
    /* La linea conectora vertical se ubica bajo el logo (columna 1). */
    ul.timeline .tl-item > hr {
      grid-column: 1;
      width: 2px;
      justify-self: center;
    }
    ul.timeline .tl-item > hr:first-child {
      grid-row: 1;
      height: 0;
    }
    ul.timeline .tl-item > hr:last-child {
      grid-row: 3;
    }
  }
</style>

<script>
  // Revela los items del timeline al entrar en viewport (aplica en cualquier
  // pagina que use el componente: home y experiencia). Deduplicado por Astro.
  function initTimelineReveal() {
    const items = Array.from(document.querySelectorAll<HTMLElement>(".tl-reveal:not(.is-visible)"));
    if (!items.length) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      items.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
    );
    items.forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initTimelineReveal);
</script>
