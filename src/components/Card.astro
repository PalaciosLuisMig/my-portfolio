---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const {
  title,
  desc,
  pubDate,
  img,
  badge,
  url,
  target = "_blank",
  github,
  website,
  skills,
} = Astro.props;

const month =
  pubDate.toLocaleString("es", { month: "short" }).charAt(0).toUpperCase() +
  pubDate.toLocaleString("es", { month: "short" }).slice(1);
const year = pubDate.getFullYear();

// Recorte de la descripcion en el servidor para garantizar longitud uniforme,
// independientemente del comportamiento de line-clamp en el navegador.
const MAX_DESC = 120;
const shortDesc =
  desc && desc.length > MAX_DESC ? desc.slice(0, MAX_DESC).trimEnd() + "…" : desc;
---

<article
  class="group card relative h-full overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-primary hover:shadow-lg hover:shadow-primary/20"
>
  <!-- Imagen -->
  <figure class="relative h-52 overflow-hidden">
    <Image
      width={960}
      height={640}
      src={img}
      alt={title}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </figure>

  <div class="card-body gap-2 p-5">
    <p class="font-mono text-xs uppercase tracking-widest text-base-content/50">
      {month} {year}
    </p>

    <h3 class="flex flex-wrap items-center gap-2 text-lg md:text-xl font-bold text-base-content leading-snug">
      <!-- Stretched link: hace clicable toda la card sin anidar <a> -->
      <a href={url} target={target} class="line-clamp-2 after:absolute after:inset-0 hover:text-primary transition-colors">
        {title}
      </a>
      {badge && <span class="badge badge-accent badge-sm font-medium shrink-0">{badge}</span>}
    </h3>

    <p class="text-sm leading-5 text-base-content/70">{shortDesc}</p>

    <!-- Skills -->
    {
      skills && skills.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1.5">
          {skills.map((skill: any) => (
            <span class="inline-flex items-center gap-1 rounded-md bg-base-200 px-2 py-1 text-xs font-medium text-base-content/80">
              {skill.logo && (
                <Icon name={`simple-icons:${skill.logo}`} size={13} class="text-base-content/60" />
              )}
              {skill.name}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <!-- Enlaces externos (por encima del stretched link) -->
  {
    (website || github) && (
      <div class="relative z-10 flex justify-end gap-3 border-t border-base-300 px-5 py-3">
        {website && (
          <a
            class="text-base-content/60 transition-colors hover:text-primary"
            href={website}
            target="_blank"
            aria-label="Sitio web del proyecto"
          >
            <Icon name="lucide:external-link" size={20} />
          </a>
        )}
        {github && (
          <a
            class="text-base-content/60 transition-colors hover:text-primary"
            href={github}
            target="_blank"
            aria-label="Repositorio en GitHub"
          >
            <Icon name="simple-icons:github" size={20} />
          </a>
        )}
      </div>
    )
  }
</article>
