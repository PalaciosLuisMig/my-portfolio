---
import { Icon } from "astro-icon/components";
import { THEMES } from "../config";
---

<div class="dropdown dropdown-end">
  <div
    tabindex="0"
    role="button"
    class="btn btn-ghost text-lg prose prose-lg hover:text-primary flex flex-row items-center flex-nowrap gap-2"
    title="Tema"
    aria-label="Seleccionar tema"
  >
    <Icon name="lucide:palette" />
    <span class="hidden lg:block">Tema</span>
  </div>
  <ul
    tabindex="0"
    class="dropdown-content menu bg-base-300 rounded-box z-40 mt-2 max-h-96 w-56 overflow-y-auto p-2 shadow-2xl"
  >
    <li class="menu-title sticky top-0 z-10 bg-base-300 py-2">
      <span class="flex items-center gap-2 text-sm font-semibold text-base-content opacity-90">
        <svg class="w-4 h-4 fill-current text-warning" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 7a5 5 0 100 10 5 5 0 000-10zM12 1a1 1 0 011 1v1a1 1 0 11-2 0V2a1 1 0 011-1zm0 18a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM4.22 4.22a1 1 0 011.42 0l.7.7a1 1 0 11-1.41 1.42l-.71-.71a1 1 0 010-1.41zm12.02 12.02a1 1 0 011.42 0l.7.7a1 1 0 11-1.41 1.42l-.71-.71a1 1 0 010-1.41zM1 12a1 1 0 011-1h1a1 1 0 110 2H2a1 1 0 01-1-1zm18 0a1 1 0 011-1h1a1 1 0 110 2h-1a1 1 0 01-1-1zM4.22 19.78a1 1 0 010-1.41l.71-.71a1 1 0 111.41 1.41l-.7.71a1 1 0 01-1.42 0zM16.24 7.76a1 1 0 010-1.41l.71-.71a1 1 0 111.41 1.41l-.7.71a1 1 0 01-1.42 0z"/>
        </svg>
        <span class="uppercase tracking-wide">Claros</span>
      </span>
    </li>
    {
      THEMES.filter((theme) => !theme.dark).map((theme) => (
        <li>
          <input
            type="radio"
            name="theme-dropdown"
            class="theme-controller w-full btn btn-sm btn-block btn-ghost justify-start font-normal"
            aria-label={theme.label}
            value={theme.name}
            data-theme-dark="false"
          />
        </li>
      ))
    }

    <li class="menu-title mt-1 py-2">
      <span class="flex items-center gap-2 text-sm font-semibold text-base-content opacity-90">
        <svg class="w-4 h-4 fill-current text-info" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M21.64 13a1 1 0 00-1.05-.14 8.05 8.05 0 01-3.37.73A8.15 8.15 0 019.08 5.49a8.59 8.59 0 01.25-2A1 1 0 008 2.36 10.14 10.14 0 1022 14.05a1 1 0 00-.36-1.05z"/>
        </svg>
        <span class="uppercase tracking-wide">Oscuros</span>
      </span>
    </li>
    {
      THEMES.filter((theme) => theme.dark).map((theme) => (
        <li>
          <input
            type="radio"
            name="theme-dropdown"
            class="theme-controller w-full btn btn-sm btn-block btn-ghost justify-start font-normal"
            aria-label={theme.label}
            value={theme.name}
            data-theme-dark="true"
          />
        </li>
      ))
    }
  </ul>
</div>

<script is:inline define:vars={{ THEMES }}>
  const DEFAULT_THEME = "fantasy";
  const DARK_THEMES = THEMES.filter((t) => t.dark).map((t) => t.name);

  // Mantener la clase "dark" para los estilos dark: de Tailwind (darkMode: "class")
  function syncDarkClass(doc, theme) {
    const html = doc.querySelector("html");
    if (DARK_THEMES.includes(theme)) {
      html.classList.add("dark");
    } else {
      html.classList.remove("dark");
    }
  }

  function initTheme(doc) {
    const theme = window.localStorage.getItem("data-theme") || DEFAULT_THEME;
    doc.querySelector("html").setAttribute("data-theme", theme);
    syncDarkClass(doc, theme);

    // Marcar el radio correspondiente como seleccionado
    doc.querySelectorAll(".theme-controller").forEach((input) => {
      input.checked = input.value === theme;
    });
  }

  function bindThemeInputs(doc) {
    doc.querySelectorAll(".theme-controller").forEach((input) => {
      input.addEventListener("change", () => {
        if (!input.checked) return;
        // DaisyUI ya aplica data-theme via CSS; solo persistimos y sincronizamos la clase dark
        window.localStorage.setItem("data-theme", input.value);
        syncDarkClass(doc, input.value);
        if (document.activeElement instanceof HTMLElement) {
          document.activeElement.blur();
        }
      });
    });
  }

  initTheme(document);
  bindThemeInputs(document);

  document.addEventListener("astro:before-swap", (ev) => {
    initTheme(ev.newDocument);
  });

  document.addEventListener("astro:after-swap", () => {
    bindThemeInputs(document);
  });
</script>
