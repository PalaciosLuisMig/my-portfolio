---
import { type ProjectSchema } from "@content/config";
import Layout from "@layouts/Layout.astro";
import dayjs from "dayjs";
import "dayjs/locale/es";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

export interface Props extends ProjectSchema {}

const { title, description, pubDate, badge, heroImage, github, website, tags, skills } =
  Astro.props;

dayjs.extend(localizedFormat);
dayjs.locale("es");
const displayDate = dayjs(pubDate).format("LL");

// URLs externas (http/https) usan <img> nativo; las locales, <Image> optimizado.
const isRemote = typeof heroImage === "string" && /^https?:\/\//.test(heroImage);

// URL canonica del proyecto para compartir (usa el `site` de astro.config).
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const shareText = `${title} — Proyecto de Luis Palacios`;
const enc = encodeURIComponent;
const SHARE_LINKS = [
  {
    name: "LinkedIn",
    icon: "simple-icons:linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(shareUrl)}`,
  },
  {
    name: "X",
    icon: "simple-icons:x",
    href: `https://twitter.com/intent/tweet?url=${enc(shareUrl)}&text=${enc(shareText)}`,
  },
  {
    name: "WhatsApp",
    icon: "simple-icons:whatsapp",
    href: `https://wa.me/?text=${enc(shareText + " " + shareUrl)}`,
  },
  {
    name: "Facebook",
    icon: "simple-icons:facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${enc(shareUrl)}`,
  },
];
---

<Layout title={title} description={description} image={heroImage} ogType="article">
  <div class="max-w-screen-lg mx-auto px-5">

    <!-- ============ HERO DEL PROYECTO ============ -->
    <section class="pt-10 md:pt-14">
      <a
        href="/projects"
        class="inline-flex items-center gap-1 text-sm text-base-content/60 hover:text-primary transition-colors mb-6 animate-fade-down"
      >
        <Icon name="lucide:arrow-left" size={16} />Volver a proyectos
      </a>

      <div class="animate-fade-up">
        <p class="font-mono text-xs uppercase tracking-widest text-primary mb-2">Proyecto</p>
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <h1 class="text-2xl md:text-4xl font-extrabold text-base-content leading-tight">
            {title}
          </h1>
          {badge && <span class="badge badge-accent badge-lg font-medium">{badge}</span>}
        </div>

        <p class="text-base-content/70 mb-4">{description}</p>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-base-content/50">
          {pubDate && (
            <span class="flex items-center gap-1">
              <Icon name="lucide:calendar" size={15} />{displayDate}
            </span>
          )}
        </div>

        <!-- Acciones: sitio web / repositorio -->
        {(website || github) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {website && (
              <a href={website} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm md:btn-md gap-2">
                <Icon name="lucide:external-link" size={18} />Ver sitio web
              </a>
            )}
            {github && (
              <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm md:btn-md gap-2">
                <Icon name="simple-icons:github" size={18} />Código fuente
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- ============ IMAGEN DESTACADA ============ -->
    {heroImage && (
      <figure class="mt-8 overflow-hidden rounded-box border border-base-300 shadow-md animate-fade-up">
        {isRemote ? (
          <img width={1280} height={720} src={heroImage} loading="lazy" alt={title} class="w-full object-cover" />
        ) : (
          <Image width={1280} height={720} src={heroImage} alt={title} class="w-full object-cover" />
        )}
      </figure>
    )}

    <!-- ============ TAGS + SKILLS ============ -->
    {((tags && tags.length > 0) || (skills && skills.length > 0)) && (
      <section class="mt-8 flex flex-col gap-4">
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="badge badge-soft badge-primary">{tag}</span>
            ))}
          </div>
        )}
        {skills && skills.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {skills.map((skill: any) => (
              <span class="inline-flex items-center gap-1.5 rounded-md bg-base-200 border border-base-300 px-2.5 py-1 text-xs font-medium text-base-content/80">
                {skill.logo && (
                  <Icon name={`simple-icons:${skill.logo}`} size={14} class="text-base-content/60" />
                )}
                {skill.name}
              </span>
            ))}
          </div>
        )}
      </section>
    )}

    <!-- ============ CONTENIDO ============ -->
    <article class="prose dark:prose-invert max-w-none mt-8">
      <slot />
    </article>

    <!-- ============ COMPARTIR ============ -->
    <section class="mt-10 flex flex-wrap items-center gap-3 border-t border-base-300 pt-6">
      <span class="flex items-center gap-1.5 text-sm font-medium text-base-content/70">
        <Icon name="lucide:share-2" size={16} class="text-primary" />Compartir:
      </span>
      {SHARE_LINKS.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Compartir en ${s.name}`}
          class="btn btn-circle btn-sm btn-ghost text-base-content/60 hover:text-primary"
        >
          <Icon name={s.icon} size={18} />
        </a>
      ))}
      <button
        id="share-copy"
        type="button"
        aria-label="Copiar enlace"
        class="btn btn-circle btn-sm btn-ghost text-base-content/60 hover:text-primary"
        data-share-url={shareUrl}
      >
        <Icon name="lucide:link" size={18} />
      </button>
    </section>

    <!-- ============ CTA FINAL ============ -->
    <section class="my-14">
      <div class="rounded-box bg-base-200 border border-base-300 p-8 text-center">
        <h2 class="text-lg md:text-xl font-bold text-base-content mb-2">¿Te interesa un proyecto así?</h2>
        <p class="text-base-content/70 max-w-xl mx-auto mb-6">
          Explora más de mi trabajo o escríbeme para conversar sobre tu idea.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/projects" class="btn btn-primary btn-sm md:btn-md gap-2">
            <Icon name="lucide:folder-git-2" size={18} />Ver más proyectos
          </a>
          <a href="/contact" class="btn btn-outline btn-sm md:btn-md gap-2">
            <Icon name="lucide:mail" size={18} />Contáctame
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- Toast: enlace copiado -->
  <div id="share-toast" class="toast toast-center hidden">
    <div class="alert alert-success">
      <Icon name="lucide:check" size={16} />
      <span>Enlace copiado</span>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("share-copy");
    const toast = document.getElementById("share-toast");
    btn?.addEventListener("click", async () => {
      const url = (btn as HTMLElement).dataset.shareUrl || window.location.href;
      // En movil, usa el menu nativo de compartir si esta disponible.
      if (navigator.share) {
        try {
          await navigator.share({ url });
          return;
        } catch {
          /* el usuario cancelo; continuamos con copiar */
        }
      }
      await navigator.clipboard.writeText(url);
      toast?.classList.remove("hidden");
      setTimeout(() => toast?.classList.add("hidden"), 2000);
    });
  });
</script>
